datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

enum Role {
  STUDENT
  FACULTY
  ALUMNI
  MODERATOR
  ADMIN
}

enum AllowDMSetting {
  EVERYONE
  FOLLOWERS_ONLY
  NONE
}

enum FollowStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GroupRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum NotificationType {
  LIKE
  COMMENT
  MENTION
  FOLLOW_REQUEST
  FOLLOW_ACCEPT
  MESSAGE_REQUEST
  EVENT_REMINDER
  GROUP_INVITE
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique
  username          String            @unique @db.VarChar(30)
  fullName          String            @db.VarChar(100)
  passwordHash      String
  avatarUrl         String?
  coverImageUrl     String?
  bio               String?           @db.VarChar(500)
  universityName    String
  graduationYear    Int
  role              Role              @default(STUDENT)
  isPrivate         Boolean           @default(false)
  isVerified        Boolean           @default(false)
  allowDM           AllowDMSetting    @default(EVERYONE)
  isBanned          Boolean           @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  identityPublicKey String?           @db.Text
  signedPreKey      String?           @db.Text

  verificationBadge VerificationBadge?
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  following         Follower[]        @relation("UserFollowing")
  followers         Follower[]        @relation("UserFollowers")
  sentMessages      DirectMessage[]   @relation("MessageSender")
  receivedMessages  DirectMessage[]   @relation("MessageRecipient")
  messageRequestsSent     MessageRequest[] @relation("RequestSender")
  messageRequestsReceived MessageRequest[] @relation("RequestRecipient")
  groupMemberships  GroupMember[]
  createdGroups     Group[]           @relation("GroupCreator")
  eventRSVPs        EventRSVP[]
  notificationsSent     Notification[] @relation("NotificationActor")
  notificationsReceived Notification[] @relation("NotificationRecipient")

  @@index([email])
  @@index([username])
  @@index([universityName])
}

model VerificationBadge {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @unique @db.Uuid
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           VerificationStatus @default(PENDING)
  studentIdCardUrl String?
  ssoId            String?            @unique
  verifiedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
}

model Follower {
  id          String       @id @default(uuid()) @db.Uuid
  followerId  String       @db.Uuid
  followingId String       @db.Uuid
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime     @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([status])
}

model Post {
  id            String    @id @default(uuid()) @db.Uuid
  authorId      String    @db.Uuid
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String    @db.Text
  mediaUrls     String[]  @default([])
  hashtags      String[]  @default([])
  mentions      String[]  @default([])
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  sharesCount   Int       @default(0)
  groupId       String?   @db.Uuid
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  comments      Comment[]
  likes         Like[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([authorId])
  @@index([groupId])
  @@index([createdAt(sort: Desc)])
  @@index([hashtags])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String    @db.Uuid
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  parentId  String?   @db.Uuid
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId, createdAt(sort: Asc)])
  @@index([authorId])
  @@index([parentId])
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model MessageRequest {
  id          String               @id @default(uuid()) @db.Uuid
  senderId    String               @db.Uuid
  sender      User                 @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String               @db.Uuid
  recipient   User                 @relation("RequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      MessageRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
}

model DirectMessage {
  id               String   @id @default(uuid()) @db.Uuid
  senderId         String   @db.Uuid
  sender           User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId      String   @db.Uuid
  recipient        User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  encryptedContent String   @db.Text
  iv               String   @db.VarChar(64)
  isRead           Boolean  @default(false)
  readAt           DateTime?
  createdAt        DateTime @default(now())

  @@index([senderId, recipientId, createdAt(sort: Desc)])
  @@index([recipientId, isRead])
}

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(100)
  description String?       @db.Text
  avatarUrl   String?
  isPrivate   Boolean       @default(false)
  creatorId   String        @db.Uuid
  creator     User          @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  maxMembers  Int           @default(500)
  memberCount Int           @default(1)

  members     GroupMember[]
  posts       Post[]
  events      Event[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
}

model GroupMember {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  groupId     String      @db.Uuid
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String      @db.VarChar(150)
  description String      @db.Text
  location    String
  startTime   DateTime
  endTime     DateTime
  capacity    Int
  filledSeats Int         @default(0)

  rsvps       EventRSVP[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([groupId])
  @@index([startTime])
}

model EventRSVP {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @db.Uuid
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String           @db.Uuid
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type        NotificationType
  entityId    String?          @db.Uuid
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead, createdAt(sort: Desc)])
}
